[Unit]
Description=SimpleLabel Java Backend
After=network.target simplelabel-yolo-worker.service
Requires=simplelabel-yolo-worker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=simplelabel
Group=simplelabel
WorkingDirectory=/opt/simplelabel/current
EnvironmentFile=/etc/simplelabel/simplelabel.env
Environment=TZ=Asia/Shanghai
ExecStartPre=/usr/bin/bash /opt/simplelabel/current/deploy/ubuntu/validate_runtime_env.sh
ExecStartPre=/usr/bin/bash /opt/simplelabel/current/deploy/ubuntu/wait_for_worker.sh
ExecStart=/usr/bin/java $SIMPLELABEL_JAVA_OPTS -jar /opt/simplelabel/current/backend-java/target/simplelabel-java-1.0.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/simplelabel/data /srv/simplelabel/models /srv/simplelabel/logs /srv/simplelabel/admin /srv/simplelabel/processed /srv/simplelabel/backups
MemoryMax=3G
CPUQuota=200%
Nice=10
IOWeight=25

[Install]
WantedBy=multi-user.target
