# Preview is loopback-only and must use isolated sample data.
SIMPLELABEL_DEPLOYMENT_MODE=preview
SIMPLELABEL_TIME_ZONE=Asia/Shanghai
SIMPLELABEL_ROOT=/opt/simplelabel/current
SIMPLELABEL_BIND_ADDRESS=127.0.0.1
SIMPLELABEL_PORT=28083
SIMPLELABEL_DATA_DIR=/srv/simplelabel-preview/data
SIMPLELABEL_MODELS_DIR=/srv/simplelabel-preview/models
SIMPLELABEL_LOGS_DIR=/srv/simplelabel-preview/logs
SIMPLELABEL_ADMIN_DIR=/srv/simplelabel-preview/admin
SIMPLELABEL_PROCESSED_DIR=/srv/simplelabel-preview/processed
SIMPLELABEL_STATIC_DIR=/opt/simplelabel/current/static
SIMPLELABEL_CACHE_DIR=/tmp/simplelabel-preview-cache
SIMPLELABEL_YOLO_WORKER_PORT=28085
SIMPLELABEL_YOLO_WORKER_URL=http://127.0.0.1:28085
SIMPLELABEL_YOLO_WORKER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
SIMPLELABEL_ADMIN_TOKEN_HASHES=
SIMPLELABEL_ADMIN_COOKIE_DAYS=365
SIMPLELABEL_ADMIN_COOKIE_SECURE=false
SIMPLELABEL_YOLO_DEVICE=cpu
# Preview must not set CUDA_VISIBLE_DEVICES.
SIMPLELABEL_JAVA_OPTS=-Xms256m -Xmx2g
