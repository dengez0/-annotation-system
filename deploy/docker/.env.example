SIMPLELABEL_UID=1000
SIMPLELABEL_GID=1000
SIMPLELABEL_DEPLOYMENT_MODE=production
SIMPLELABEL_TIME_ZONE=Asia/Shanghai
SIMPLELABEL_ROOT=/opt/simplelabel/current
SIMPLELABEL_BIND_ADDRESS=0.0.0.0
SIMPLELABEL_PORT=18083
SIMPLELABEL_MODEL_DETECTION_PORT=8000
SIMPLELABEL_DATA_DIR=/srv/simplelabel/data
SIMPLELABEL_MODELS_DIR=/srv/simplelabel/models
SIMPLELABEL_LOGS_DIR=/srv/simplelabel/logs
SIMPLELABEL_ADMIN_DIR=/srv/simplelabel/admin
SIMPLELABEL_PROCESSED_DIR=/srv/simplelabel/processed
SIMPLELABEL_BACKUPS_DIR=/srv/simplelabel/backups
SIMPLELABEL_STATIC_DIR=/opt/simplelabel/current/static
SIMPLELABEL_CACHE_DIR=/tmp/simplelabel-cache
SIMPLELABEL_YOLO_WORKER_PORT=18085
SIMPLELABEL_YOLO_WORKER_URL=http://127.0.0.1:18085
SIMPLELABEL_YOLO_WORKER_TOKEN=GENERATED_BY_DEPLOY_SCRIPT
# One-time bootstrap only. Clear this after admin_tokens.json has been created and verified.
SIMPLELABEL_ADMIN_TOKEN_HASHES=
SIMPLELABEL_ADMIN_COOKIE_DAYS=365
# Keep false for the current direct HTTP deployment. Change to true only after HTTPS is enabled.
SIMPLELABEL_ADMIN_COOKIE_SECURE=false
SIMPLELABEL_YOLO_DEVICE=cpu
SIMPLELABEL_JAVA_OPTS=-Xms256m -Xmx2g
